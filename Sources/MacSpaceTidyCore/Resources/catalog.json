{
  "entries": [
    { "id": "library-caches", "path": "~/Library/Caches/*", "category": "caches", "action": "delete", "risk": "low", "checkedByDefault": true, "needsAdmin": false, "ownerApps": [],
      "reason": "App cache. The app rebuilds it. Quit the app first." },
    { "id": "library-logs", "path": "~/Library/Logs/*", "category": "caches", "action": "delete", "risk": "low", "checkedByDefault": true, "needsAdmin": false, "ownerApps": [],
      "reason": "Old logs. Keep them only if you debug a problem now." },
    { "id": "homebrew-cache", "canMove": true, "path": "~/Library/Caches/Homebrew", "category": "caches", "action": "delete", "risk": "low", "checkedByDefault": true, "needsAdmin": false, "ownerApps": ["brew"],
      "reason": "Downloaded Homebrew packages. Homebrew downloads them again when needed." },
    { "id": "trash", "path": "~/.Trash", "category": "caches", "action": "delete", "risk": "medium", "checkedByDefault": false, "needsAdmin": false, "ownerApps": [],
      "reason": "Files you already moved to the Trash. Empty it to free the space." },

    { "id": "xcode-derived-data", "canMove": true, "path": "~/Library/Developer/Xcode/DerivedData", "category": "developer", "action": "delete", "risk": "low", "checkedByDefault": true, "needsAdmin": false, "ownerApps": ["Xcode"],
      "reason": "Xcode build output. Xcode rebuilds it on the next build." },
    { "id": "xcode-ios-device-support", "canMove": true, "path": "~/Library/Developer/Xcode/iOS DeviceSupport", "category": "developer", "action": "delete", "risk": "low", "checkedByDefault": true, "needsAdmin": false, "ownerApps": ["Xcode"],
      "reason": "Debug symbols for connected iPhones. Xcode copies them again when you connect a device." },
    { "id": "uv-cache", "canMove": true, "path": "~/.cache/uv", "category": "developer", "action": "delete", "risk": "low", "checkedByDefault": true, "needsAdmin": false, "ownerApps": ["uv"],
      "reason": "Python package cache of uv. uv downloads packages again when needed." },
    { "id": "npm-cache", "canMove": true, "path": "~/.npm", "category": "developer", "action": "delete", "risk": "low", "checkedByDefault": true, "needsAdmin": false, "ownerApps": ["npm"],
      "reason": "npm package cache. npm downloads packages again when needed." },
    { "id": "gradle-caches", "canMove": true, "path": "~/.gradle/caches", "category": "developer", "action": "delete", "risk": "low", "checkedByDefault": true, "needsAdmin": false, "ownerApps": [],
      "reason": "Gradle dependency and build cache. Gradle downloads it again. Stop Gradle daemons first." },
    { "id": "nuget-packages", "canMove": true, "path": "~/.nuget/packages", "category": "developer", "action": "delete", "risk": "low", "checkedByDefault": true, "needsAdmin": false, "ownerApps": ["dotnet"],
      "reason": "NuGet package cache. dotnet restores packages again when needed." },
    { "id": "bun-cache", "canMove": true, "path": "~/.bun/install/cache", "category": "developer", "action": "delete", "risk": "low", "checkedByDefault": true, "needsAdmin": false, "ownerApps": ["bun"],
      "reason": "Bun package cache. Bun downloads packages again when needed." },
    { "id": "core-simulator-caches", "path": "/Library/Developer/CoreSimulator/Caches", "category": "developer", "action": "delete", "risk": "low", "checkedByDefault": false, "needsAdmin": true, "ownerApps": ["Simulator"],
      "reason": "System cache of iOS simulators. The system rebuilds it. Owned by root: needs the admin password, always deleted now. Do not move it: the system reads it before external disks are mounted." },

    { "id": "app-support-cursor", "path": "~/Library/Application Support/Cursor", "category": "apps", "action": "move", "risk": "low", "checkedByDefault": false, "needsAdmin": false, "ownerApps": ["Cursor"],
      "reason": "Cursor data. Works from an external disk. Quit Cursor first." },
    { "id": "app-support-claude", "path": "~/Library/Application Support/Claude", "category": "apps", "action": "move", "risk": "low", "checkedByDefault": false, "needsAdmin": false, "ownerApps": ["Claude"],
      "reason": "Claude desktop app data. Works from an external disk. Quit Claude first." },
    { "id": "app-support-jetbrains", "path": "~/Library/Application Support/JetBrains", "category": "apps", "action": "move", "risk": "low", "checkedByDefault": false, "needsAdmin": false, "ownerApps": [],
      "reason": "JetBrains IDE settings and plugins. Works from an external disk. Quit all JetBrains IDEs first." },
    { "id": "app-support-steam", "path": "~/Library/Application Support/Steam", "category": "apps", "action": "move", "risk": "low", "checkedByDefault": false, "needsAdmin": false, "ownerApps": ["steam_osx"],
      "reason": "Steam data and games. Works from an external disk. Quit Steam first." },
    { "id": "app-support-whisky", "path": "~/Library/Application Support/com.isaacmarovitz.Whisky", "category": "apps", "action": "move", "risk": "medium", "checkedByDefault": false, "needsAdmin": false, "ownerApps": ["Whisky"],
      "reason": "Whisky (Wine) bottles. Large. Move, do not delete: it holds installed Windows apps." },
    { "id": "app-support-figma", "path": "~/Library/Application Support/Figma", "category": "apps", "action": "move", "risk": "medium", "checkedByDefault": false, "needsAdmin": false, "ownerApps": ["Figma"],
      "reason": "Figma offline cache. Works from an external disk. Quit Figma first." },
    { "id": "epic-games", "path": "/Users/Shared/Epic Games", "category": "apps", "action": "move", "risk": "medium", "checkedByDefault": false, "needsAdmin": false, "ownerApps": ["EpicGamesLauncher"],
      "reason": "Epic Games installs. The Epic launcher also uses this folder. Safer: reinstall the game to the external disk from the launcher." },
    { "id": "xcode-archives", "path": "~/Library/Developer/Xcode/Archives", "category": "developer", "action": "move", "risk": "low", "checkedByDefault": false, "needsAdmin": false, "ownerApps": ["Xcode"],
      "reason": "Old Xcode archives. You may need them to read crash reports. Move them, or delete after export." },
    { "id": "android-home", "path": "~/.android", "category": "developer", "action": "move", "risk": "low", "checkedByDefault": false, "needsAdmin": false, "ownerApps": ["studio", "qemu-system-aarch64"],
      "reason": "Android emulators and settings. Works from an external disk. Close Android Studio and emulators first." },
    { "id": "cocoapods-home", "path": "~/.cocoapods", "category": "developer", "action": "move", "risk": "low", "checkedByDefault": false, "needsAdmin": false, "ownerApps": [],
      "reason": "CocoaPods spec repos. Works from an external disk." },

    { "id": "containers", "path": "~/Library/Containers", "category": "cleanInApp", "action": "cleanInApp", "risk": "high", "checkedByDefault": false, "needsAdmin": false, "ownerApps": [],
      "reason": "Data of sandboxed apps. Deleting it breaks apps. Clean it inside each app or uninstall the app." },
    { "id": "group-containers", "path": "~/Library/Group Containers", "category": "cleanInApp", "action": "cleanInApp", "risk": "high", "checkedByDefault": false, "needsAdmin": false, "ownerApps": [],
      "reason": "Data shared between apps (iCloud, Office, Teams). Clean it inside the apps." },
    { "id": "mail", "path": "~/Library/Mail", "category": "cleanInApp", "action": "cleanInApp", "risk": "high", "checkedByDefault": false, "needsAdmin": false, "ownerApps": ["Mail"],
      "reason": "Mail messages. Remove accounts or mailboxes in the Mail app." },
    { "id": "messages", "path": "~/Library/Messages", "category": "cleanInApp", "action": "cleanInApp", "risk": "high", "checkedByDefault": false, "needsAdmin": false, "ownerApps": ["Messages"],
      "reason": "iMessage history and attachments. Delete old chats in the Messages app." },
    { "id": "safari", "path": "~/Library/Safari", "category": "cleanInApp", "action": "cleanInApp", "risk": "high", "checkedByDefault": false, "needsAdmin": false, "ownerApps": ["Safari"],
      "reason": "Safari data. Use Safari → Clear History." },

    { "id": "preferences", "path": "~/Library/Preferences", "category": "system", "action": "never", "risk": "high", "checkedByDefault": false, "needsAdmin": false, "ownerApps": [],
      "reason": "App and system settings." },
    { "id": "keychains", "path": "~/Library/Keychains", "category": "system", "action": "never", "risk": "high", "checkedByDefault": false, "needsAdmin": false, "ownerApps": [],
      "reason": "Passwords and certificates." },
    { "id": "identity-services", "path": "~/Library/IdentityServices", "category": "system", "action": "never", "risk": "high", "checkedByDefault": false, "needsAdmin": false, "ownerApps": [],
      "reason": "Apple ID sign-in state." },
    { "id": "cloud-storage", "path": "~/Library/CloudStorage", "category": "system", "action": "never", "risk": "high", "checkedByDefault": false, "needsAdmin": false, "ownerApps": [],
      "reason": "Cloud drive folders (Google Drive, Dropbox, OneDrive)." },
    { "id": "icloud-drive", "path": "~/Library/Mobile Documents", "category": "system", "action": "never", "risk": "high", "checkedByDefault": false, "needsAdmin": false, "ownerApps": [],
      "reason": "iCloud Drive." },
    { "id": "biome", "path": "~/Library/Biome", "category": "system", "action": "never", "risk": "high", "checkedByDefault": false, "needsAdmin": false, "ownerApps": [],
      "reason": "On-device intelligence data of macOS." },
    { "id": "launch-agents", "path": "~/Library/LaunchAgents", "category": "system", "action": "never", "risk": "high", "checkedByDefault": false, "needsAdmin": false, "ownerApps": [],
      "reason": "Startup items." },
    { "id": "fonts", "path": "~/Library/Fonts", "category": "system", "action": "never", "risk": "high", "checkedByDefault": false, "needsAdmin": false, "ownerApps": [],
      "reason": "Your fonts." },
    { "id": "spotlight-metadata", "path": "~/Library/Metadata", "category": "system", "action": "never", "risk": "high", "checkedByDefault": false, "needsAdmin": false, "ownerApps": [],
      "reason": "Spotlight search index and app metadata. macOS manages it." },
    { "id": "daemon-containers", "path": "~/Library/Daemon Containers", "category": "system", "action": "never", "risk": "high", "checkedByDefault": false, "needsAdmin": false, "ownerApps": [],
      "reason": "Data of macOS background services." },
    { "id": "system", "path": "/System", "category": "system", "action": "never", "risk": "high", "checkedByDefault": false, "needsAdmin": false, "ownerApps": [],
      "reason": "macOS itself. Protected by SIP." },
    { "id": "mac-space-tidy", "path": "~/Library/Application Support/MacSpaceTidy", "category": "system", "action": "never", "risk": "high", "checkedByDefault": false, "needsAdmin": false, "ownerApps": [],
      "reason": "MacSpaceTidy settings and move journal. Must stay on the internal disk." }
  ]
}
